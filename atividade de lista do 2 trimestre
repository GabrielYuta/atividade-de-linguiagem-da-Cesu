#include <stdio.h>
#include <stdlib.h>
#include <math.h>

/* EXERCICIO 1 */
void ler100(int numeros[100]) {
    int i;
    for (i = 0; i < 100; i++) {
        printf("Digite o numero %d: ", i + 1);
        scanf("%d", &numeros[i]);
    }
}

void mostrarInverso(int numeros[100]) {
    int i;
    printf("Numeros na ordem inversa:\n");
    for (i = 99; i >= 0; i--) {
        printf("%d ", numeros[i]);
    }
    printf("\n");
}

void ordenarDecrescente(int numeros[100]) {
    int i, j, auxiliar;
    for (i = 0; i < 100; i++) {
        for (j = i + 1; j < 100; j++) {
            if (numeros[i] < numeros[j]) {
                auxiliar = numeros[i];
                numeros[i] = numeros[j];
                numeros[j] = auxiliar;
            }
        }
    }
}
