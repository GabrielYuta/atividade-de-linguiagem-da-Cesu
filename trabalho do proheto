#include <stdio.h>
#include <string.h>

#define MAX 100

typedef struct {
    char nome[50];
    int idade;
    char telefone[20];
} Pessoa;

int main() {

    Pessoa pessoas[MAX];
    int quantidade = 0;
    int opcao;
    int i;
    char busca[50];

    do {

        printf("\n===== SISTEMA DE CADASTRO =====\n");
        printf("1 - Cadastrar pessoa\n");
        printf("2 - Listar pessoas\n");
        printf("3 - Pesquisar pessoa\n");
        printf("4 - Excluir cadastro\n");
        printf("5 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch (opcao) {

            case 1:

                if (quantidade < MAX) {

                    printf("\nNome: ");
                    fgets(pessoas[quantidade].nome, 50, stdin);
                    pessoas[quantidade].nome[
                        strcspn(pessoas[quantidade].nome, "\n")
                    ] = '\0';

                    printf("Idade: ");
                    scanf("%d", &pessoas[quantidade].idade);
                    getchar();

                    printf("Telefone: ");
                    fgets(pessoas[quantidade].telefone, 20, stdin);
                    pessoas[quantidade].telefone[
                        strcspn(pessoas[quantidade].telefone, "\n")
                    ] = '\0';

                    quantidade++;

                    printf("\nCadastro realizado com sucesso!\n");

                } else {
                    printf("\nLimite de cadastros atingido!\n");
                }

                break;

            case 2:

                printf("\n===== PESSOAS CADASTRADAS =====\n");

                if (quantidade == 0) {
                    printf("Nenhuma pessoa cadastrada.\n");
                }

                for (i = 0; i < quantidade; i++) {

                    printf("\nCadastro %d\n", i + 1);
                    printf("Nome: %s\n", pessoas[i].nome);
                    printf("Idade: %d\n", pessoas[i].idade);
                    printf("Telefone: %s\n", pessoas[i].telefone);

                }

                break;

            case 3:

                printf("\nDigite o nome para pesquisar: ");
                fgets(busca, 50, stdin);
                busca[strcspn(busca, "\n")] = '\0';

                for (i = 0; i < quantidade; i++) {

                    if (strcmp(pessoas[i].nome, busca) == 0) {

                        printf("\nPessoa encontrada!\n");
                        printf("Nome: %s\n", pessoas[i].nome);
                        printf("Idade: %d\n", pessoas[i].idade);
                        printf("Telefone: %s\n", pessoas[i].telefone);

                        break;
                    }
                }

                if (i == quantidade) {
                    printf("\nPessoa nao encontrada!\n");
                }

                break;

            case 4:

                printf("\nDigite o nome que deseja excluir: ");
                fgets(busca, 50, stdin);
                busca[strcspn(busca, "\n")] = '\0';

                for (i = 0; i < quantidade; i++) {

                    if (strcmp(pessoas[i].nome, busca) == 0) {

                        for (int j = i; j < quantidade - 1; j++) {
                            pessoas[j] = pessoas[j + 1];
                        }

                        quantidade--;

                        printf("\nCadastro excluido com sucesso!\n");

                        break;
                    }
                }

                if (i == quantidade) {
                    printf("\nPessoa nao encontrada!\n");
                }

                break;

            case 5:

                printf("\nEncerrando o sistema...\n");
                break;

            default:

                printf("\nOpcao invalida! Tente novamente.\n");

        }

    } while (opcao != 5);

    return 0;
}
